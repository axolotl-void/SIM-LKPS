# SIM-LKPS Environment Variables
# Copy file ini ke .env dan isi dengan nilai asli Anda

# ============================================
# Database
# ============================================
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ============================================
# Auth.js v5 (NextAuth)
# ============================================
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ============================================
# SSO dari SPMI (spmi.bbg.ac.id) — RANCANGAN-014
# ============================================
# Rahasia bersama penanda tangan token masuk. Nilainya harus SAMA PERSIS
# dengan $sso_lkps_secret di system/config.php milik SPMI.
# Minimal 32 karakter. Generate: openssl rand -base64 32
# Kalau kosong, /masuk menolak semua permintaan (gagal menutup, bukan membuka).
SSO_SPMI_SECRET=""
# "1" = pengguna SPMI yang belum punya akun di SIM-LKPS dibuatkan otomatis
# (peran mengikuti portal SPMI: LPM → ADMIN, Auditee → OPERATOR).
# "0" = hanya email yang sudah terdaftar di halaman Pengguna yang boleh masuk.
SSO_SPMI_AUTOPROVISI="1"
# Alamat SPMI, dipakai tombol "Kembali ke SPMI" di sidebar.
# Server uji: https://spmi.zegika.com — kampus: https://spmi.bbg.ac.id
NEXT_PUBLIC_SPMI_URL="https://spmi.bbg.ac.id"
NEXTAUTH_SECRET="same-as-auth-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="false"

# ============================================
# Cloudflare R2 (production)
# ============================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="sim-lkps-evidence"
R2_PUBLIC_URL="https://evidence.yourdomain.com"

# ============================================
# MinIO (opsional, development lokal)
# ============================================
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="evidence"
MINIO_USE_SSL=false

# ============================================
# App
# ============================================
NEXT_PUBLIC_APP_NAME="SIM-LKPS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Sandi awal untuk `pnpm db:seed`
# ---------------------------------------------------------------------------
# Seed TIDAK lagi memakai sandi bawaan yang ditulis di kode. Isi nilainya di
# `.env` (berkas itu tidak ikut ter-commit), JANGAN di berkas ini.
#
#   SEED_ADMIN_PASSWORD="hasil-dari-openssl-rand-base64-18"
#   SEED_OPERATOR_PASSWORD="..."
#   SEED_PIMPINAN_PASSWORD="..."
#
# Kalau tidak diisi: seed berhenti untuk admin, dan akun operator/pimpinan
# dibuat dalam keadaan nonaktif. Tidak ada akun dengan sandi yang bisa ditebak.
# ---------------------------------------------------------------------------
