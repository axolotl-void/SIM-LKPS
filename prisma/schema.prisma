// SIM-LKPS — Initial Prisma Schema
// Agent: CTO Agent
// Sprint: 0
// Version: 1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  OPERATOR
  PIMPINAN
}

enum TabelStatus {
  DRAFT
  DIAJUKAN
  DIREVISI
  DISETUJUI
  DITOLAK
}

enum ValidationAction {
  SUBMIT
  APPROVE
  REJECT
  REVISE
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

// ============================================================================
// AUTH (Auth.js / NextAuth v5 compatible)
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String    // bcrypt hashed
  image         String?
  role          Role      @default(OPERATOR)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  submittedTabels   TabelLkps[]         @relation("SubmittedBy")
  validatedTabels   TabelLkps[]         @relation("ValidatedBy")
  validationHistory ValidationHistory[]
  uploadedEvidence  Evidence[]

  // Modul LED + Penilaian (LAM INFOKOM 2.1)
  ledIsianUpdated     LedIsian[]      @relation("LedUpdatedBy")
  ledEvidenceUploaded LedEvidence[]   @relation("LedEvidenceUploadedBy")
  skorDinilai         SkorPenilaian[] @relation("SkorDinilaiOleh")

  @@index([role])
  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// MASTER DATA
// ============================================================================

model Prodi {
  id        String   @id @default(cuid())
  nama      String   // "Ilmu Komputer"
  jenjang   String   // "S1"
  kode      String   @unique // "55201"
  fakultas  String   // "Fakultas Keguruan dan Ilmu Pendidikan"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tahunAkademik TahunAkademik[]

  @@map("prodi")
}

model TahunAkademik {
  id        String   @id @default(cuid())
  tahun     String   // "2024/2025"
  semester  String   // "Ganjil" | "Genap"
  isActive  Boolean  @default(false)
  prodiId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prodi     Prodi       @relation(fields: [prodiId], references: [id])
  tabelLkps TabelLkps[]

  // Modul LED + Penilaian (LAM INFOKOM 2.1)
  ledIsian      LedIsian[]
  penilaianSesi PenilaianSesi[]

  @@unique([tahun, semester, prodiId])
  @@map("tahun_akademik")
}

model Dosen {
  id                  String   @id @default(cuid())
  nidn                String   @unique
  nama                String
  jabatanFungsional   String?  // "Lektor", "Lektor Kepala", "Guru Besar"
  pendidikanTerakhir  String   // "S2", "S3"
  bidangKeahlian      String?
  status              String   @default("Tetap") // "Tetap" | "Tidak Tetap"
  jenisKelamin        String   // "L" | "P"
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([nama])
  @@index([status])
  @@map("dosen")
}

model Tendik {
  id                  String   @id @default(cuid())
  nip                 String   @unique
  nama                String
  jabatan             String?
  pendidikanTerakhir  String
  status              String   @default("Aktif")
  jenisKelamin        String
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([nama])
  @@map("tendik")
}

model Mahasiswa {
  id           String   @id @default(cuid())
  nim          String   @unique
  nama         String
  angkatan     Int      // 2020, 2021, ...
  status       String   @default("Aktif") // "Aktif", "Cuti", "Lulus", "DO"
  jenisKelamin String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([angkatan])
  @@index([status])
  @@index([nama])
  @@map("mahasiswa")
}

model MataKuliah {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  sks       Int
  semester  Int      // 1-8
  kategori  String?  // "Wajib", "Pilihan"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semester])
  @@map("mata_kuliah")
}

// ============================================================================
// TABEL LKPS
// ============================================================================

/// Definisi 31 tabel LKPS (metadata, kolom-kolom)
model TabelDefinition {
  id               String   @id @default(cuid())
  kode             String   @unique // "1.A.1", "2.B.3", etc.
  nama             String   // "Pimpinan dan Tupoksi UPPS dan PS"
  bab              Int      // 1-6
  urutan           Int      // Urutan dalam BAB
  deskripsi        String?
  kolomDefinitions Json     // Array of column definitions
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tabelLkps TabelLkps[]

  @@index([bab])
  @@map("tabel_definition")
}

/// Instance tabel LKPS per tahun akademik
model TabelLkps {
  id                String      @id @default(cuid())
  tabelDefinitionId String
  tahunAkademikId   String
  status            TabelStatus @default(DRAFT)
  submittedById     String?
  submittedAt       DateTime?
  validatedById     String?
  validatedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tabelDefinition   TabelDefinition    @relation(fields: [tabelDefinitionId], references: [id])
  tahunAkademik     TahunAkademik      @relation(fields: [tahunAkademikId], references: [id])
  submittedBy       User?              @relation("SubmittedBy", fields: [submittedById], references: [id])
  validatedBy       User?              @relation("ValidatedBy", fields: [validatedById], references: [id])
  rows              TabelLkpsRow[]
  evidence          Evidence[]
  validationHistory ValidationHistory[]

  @@unique([tabelDefinitionId, tahunAkademikId])
  @@index([status])
  @@index([tahunAkademikId])
  @@map("tabel_lkps")
}

/// Baris data dalam tabel LKPS (dynamic columns via JSON)
model TabelLkpsRow {
  id          String   @id @default(cuid())
  tabelLkpsId String
  rowOrder    Int
  rowData     Json     // Dynamic column data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tabelLkps TabelLkps @relation(fields: [tabelLkpsId], references: [id], onDelete: Cascade)

  @@index([tabelLkpsId])
  @@index([rowOrder])
  @@map("tabel_lkps_row")
}

// ============================================================================
// EVIDENCE (Bukti Pendukung)
// ============================================================================

model Evidence {
  id          String   @id @default(cuid())
  tabelLkpsId String
  filename    String   // Original filename (for uploaded files) or "Link Drive" for links
  minioKey    String?  // Object key in MinIO (null for links)
  mimeType    String?  // "application/pdf", "image/jpeg", etc. (null for links)
  size        Int?     // File size in bytes (null for links)
  linkUrl     String?  // External URL (Google Drive, image URL, etc.)
  version     Int      @default(1)
  description String?
  uploadedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tabelLkps  TabelLkps @relation(fields: [tabelLkpsId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([tabelLkpsId])
  @@map("evidence")
}

// ============================================================================
// VALIDATION WORKFLOW
// ============================================================================

model ValidationHistory {
  id          String           @id @default(cuid())
  tabelLkpsId String
  userId      String
  action      ValidationAction
  comment     String?
  createdAt   DateTime         @default(now())

  tabelLkps TabelLkps @relation(fields: [tabelLkpsId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([tabelLkpsId])
  @@index([createdAt])
  @@map("validation_history")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // "CREATE", "UPDATE", "DELETE", "LOGIN", "LOGOUT"
  entity    String   // "User", "TabelLkps", "Dosen", etc.
  entityId  String?  // ID of affected entity
  oldValue  Json?    // Previous value
  newValue  Json?    // New value
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================================
// NOTIFICATION
// ============================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?          // URL to navigate to
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// MODUL LED — Laporan Evaluasi Diri (LAM INFOKOM 2.1)
// ============================================================================

enum LedJenis {
  NARASI // isian teks/markdown
  KRITERIA // 6 kriteria PPEPP
  SUPLEMEN // 4 bagian suplemen prodi
  IDENTITAS // identitas pengusul / tim penyusun
}

enum LedStatus {
  KOSONG
  DRAFT
  LENGKAP
  DIAJUKAN
  DISETUJUI
}

/// Struktur baku LED (Lampiran 1 Instrumen LED). Di-seed, bukan diinput user.
model LedBagian {
  id           String   @id @default(cuid())
  kode         String   @unique // "BAB1.A", "BAB2.C.1.1.A", "BAB2.D.1"
  bab          String // "I" | "II" | "III"
  bagian       String // "A" | "B" | "C" | "D" | "-"
  subBagian    String?
  judul        String
  petunjuk     String?  @db.Text // teks panduan asli dari instrumen PDF
  jenis        LedJenis
  kriteria     Int? // 1-6 untuk KRITERIA
  tahapPpepp   String? // "PENETAPAN" | "PELAKSANAAN" | ... untuk KRITERIA
  subButir     String? // "A" | "B" | "C" | "D"
  urutan       Int
  batasHalaman Int? // maks halaman per bagian (Lampiran 2)

  isian LedIsian[]

  @@index([bab, urutan])
  @@index([jenis])
  @@map("led_bagian")
}

/// Isi naratif per bagian per tahun akademik
model LedIsian {
  id              String    @id @default(cuid())
  ledBagianId     String
  tahunAkademikId String
  konten          String    @db.Text @default("") // Markdown
  status          LedStatus @default(KOSONG)
  jumlahKarakter  Int       @default(0)
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ledBagian     LedBagian     @relation(fields: [ledBagianId], references: [id], onDelete: Cascade)
  tahunAkademik TahunAkademik @relation(fields: [tahunAkademikId], references: [id])
  updatedBy     User?         @relation("LedUpdatedBy", fields: [updatedById], references: [id])
  evidence      LedEvidence[]

  @@unique([ledBagianId, tahunAkademikId])
  @@index([status])
  @@index([tahunAkademikId])
  @@map("led_isian")
}

/// Bukti pendukung khusus LED (terpisah dari Evidence tabel LKPS)
model LedEvidence {
  id           String   @id @default(cuid())
  ledIsianId   String
  filename     String
  minioKey     String?
  mimeType     String?
  size         Int?
  linkUrl      String?
  keterangan   String?
  uploadedById String
  createdAt    DateTime @default(now())

  ledIsian   LedIsian @relation(fields: [ledIsianId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("LedEvidenceUploadedBy", fields: [uploadedById], references: [id])

  @@index([ledIsianId])
  @@map("led_evidence")
}

// ============================================================================
// MODUL MATRIKS PENILAIAN — 77 butir inti + 5 suplemen, bobot 400
// ============================================================================

enum JenisPenilaian {
  INPUT // I
  PROSES // P
  OUTPUT // O
}

/// Butir penilaian baku dari Matriks Penilaian LAM INFOKOM. Di-seed.
model ButirPenilaian {
  id               String         @id @default(cuid())
  kode             String         @unique // "1.1.A", "2.2.D", "6.3", "SUP.3"
  kriteria         String // "KE" | "PU" | "C1".."C6" | "SUP"
  namaKriteria     String
  tahapPpepp       String?
  subButir         String? // "A" | "B" | "C" | "D"
  elemenPenilaian  String         @db.Text
  deskriptor       String         @db.Text
  skor1            String         @db.Text
  skor2            String         @db.Text
  skor3            String         @db.Text
  skor4            String         @db.Text
  syaratUnggul     String?        @db.Text
  bobot            Float // 2,0 - 30,0
  jenis            JenisPenilaian
  urutan           Int

  skor SkorPenilaian[]

  @@index([kriteria])
  @@index([jenis])
  @@map("butir_penilaian")
}

/// Sesi penilaian mandiri per tahun akademik
model PenilaianSesi {
  id              String   @id @default(cuid())
  tahunAkademikId String
  catatan         String?  @db.Text
  finalisasi      Boolean  @default(false)
  nilaiAkhir      Float?
  statusPrediksi  String? // "TIDAK_TERAKREDITASI" | "TERAKREDITASI" | "UNGGUL_3TH" | "UNGGUL_5TH"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tahunAkademik TahunAkademik    @relation(fields: [tahunAkademikId], references: [id])
  skor          SkorPenilaian[]

  @@unique([tahunAkademikId])
  @@map("penilaian_sesi")
}

/// Skor 1-4 per butir
model SkorPenilaian {
  id               String   @id @default(cuid())
  penilaianSesiId  String
  butirPenilaianId String
  skor             Int? // 1-4, null = belum dinilai
  catatanBukti     String?  @db.Text
  dinilaiOlehId    String?
  updatedAt        DateTime @updatedAt

  penilaianSesi  PenilaianSesi  @relation(fields: [penilaianSesiId], references: [id], onDelete: Cascade)
  butirPenilaian ButirPenilaian @relation(fields: [butirPenilaianId], references: [id])
  dinilaiOleh    User?          @relation("SkorDinilaiOleh", fields: [dinilaiOlehId], references: [id])

  @@unique([penilaianSesiId, butirPenilaianId])
  @@map("skor_penilaian")
}

// ============================================================================
// KEAMANAN — pembatas percobaan login
// ============================================================================

/// Hitungan percobaan login yang gagal, per alamat IP.
///
/// KENAPA DI DATABASE, BUKAN DI MEMORI:
/// Aplikasi ini berjalan di Vercel, yang menjalankan beberapa instance
/// sekaligus dan mendaur ulang instance kapan saja. Penghitung yang disimpan
/// di memori proses hanya berlaku untuk instance itu, dan hilang begitu
/// instance-nya didaur ulang. Akibatnya pembatasnya praktis tidak pernah
/// tercapai — penyerang bisa mencoba sandi sepuasnya.
///
/// Di database, penghitung ini berlaku untuk semua instance sekaligus.
///
/// Satu baris per (ip, jendela waktu). Baris lama dibersihkan otomatis.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  /// Jumlah percobaan GAGAL di jendela ini. Login yang berhasil mengosongkan.
  count     Int      @default(0)
  /// Awal jendela waktu (detik Unix).
  windowStart BigInt
  /// Kapan baris ini boleh dibersihkan (detik Unix).
  expiresAt BigInt
  updatedAt DateTime @updatedAt

  @@unique([ip, windowStart])
  @@index([expiresAt])
  @@map("login_attempt")
}
