# ---------------------------------------------------------------------------
# Sandi akun untuk uji E2E (Playwright)
# ---------------------------------------------------------------------------
#
# CARA PAKAI:
#   1. Salin berkas ini jadi `tests/.env.test` (berkas itu tidak ikut ter-commit)
#   2. Isi sandi akun uji
#   3. Jalankan uji terhadap DB UJI, bukan produksi:
#
#        DATABASE_URL="postgresql://postgres:SANDI_LOKAL@localhost:5432/sim_lkps_uji" \
#          npx playwright test --config=tests/playwright.config.ts
#
# KENAPA TIDAK DITULIS DI KODE:
#   Repo ini publik. Sandi yang ditulis di kode akan terbaca siapa pun yang
#   membuka GitHub, termasuk bot pemindai. Sandi yang pernah tertulis di kode
#   harus dianggap bocor selamanya karena tetap tersimpan di riwayat git.
#
# PENGAMAN: `tests/global-setup-penilaian.ts` akan MENOLAK berjalan kalau
#   DATABASE_URL bukan localhost — supaya uji tidak menyentuh data produksi.
#
# ---------------------------------------------------------------------------

TEST_ADMIN_PASSWORD=""
TEST_OPERATOR_PASSWORD=""
TEST_PIMPINAN_PASSWORD=""

# Basis data uji (Docker lokal). Jangan arahkan ke Neon produksi.
DATABASE_URL="postgresql://postgres:SANDI_DB_LOKAL@localhost:5432/sim_lkps_uji"
