# Contoh isi deploy/.env.production — SALIN jadi .env.production lalu isi.
# Berkas aslinya JANGAN di-commit (sudah masuk .gitignore lewat pola `.env*`).

# --- Wajib ---------------------------------------------------------------
# Kunci tanda tangan sesi. Bikin baru untuk server kampus:
#   openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="https://lkps.bbg.ac.id"
NEXTAUTH_URL="https://lkps.bbg.ac.id"
AUTH_TRUST_HOST=true

# --- Database ------------------------------------------------------------
# Pilihan 1 (paling cepat): tetap pakai Neon.
# DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
# Pilihan 2: Postgres di server kampus (service `postgres` di docker-compose.prod.yml).
DATABASE_URL="postgresql://postgres:SANDI@127.0.0.1:5432/sim_lkps"

# --- Penyimpanan bukti ---------------------------------------------------
# Pilihan 1: tetap Cloudflare R2 (endpoint R2). Pilihan 2: MinIO lokal.
MINIO_ENDPOINT="127.0.0.1"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="evidence"

# --- Integrasi SPMI (RANCANGAN-014) -------------------------------------
# Rahasia bersama dengan spmi.bbg.ac.id. Nilai sama HARUS ada di kedua sisi.
#   openssl rand -hex 32
SSO_SPMI_SECRET=
SSO_SPMI_AUTOPROVISI="1"

# --- Tampilan ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="SIM-LKPS"
NEXT_PUBLIC_APP_URL="https://lkps.bbg.ac.id"
# Alamat SPMI untuk tombol "Kembali ke SPMI" di sidebar.
NEXT_PUBLIC_SPMI_URL="https://spmi.bbg.ac.id"

# --- Seed awal (sekali saja, saat `pnpm db:seed`) ------------------------
SEED_ADMIN_PASSWORD=
